[Unit]
Description=Repairs helper web application
After=network.target postgresql.service

[Service]
Type=simple
User=repairshelper
Group=repairshelper
WorkingDirectory=/srv/repairshelper/current
EnvironmentFile=/etc/repairshelper/app.env
# Every live shop is in America/Edmonton; server-rendered dates follow the process time zone
# until all server code formats in each shop's own zone. On the VPS this line lives in
# /etc/systemd/system/repairshelper.service.d/timezone.conf.
Environment=TZ=America/Edmonton
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/repairshelper
MemoryMax=1G
UMask=0077

[Install]
WantedBy=multi-user.target
