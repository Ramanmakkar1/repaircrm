// RepairFlow — multi-tenant repair-shop management schema
//
// CONVENTIONS
// 1. Multi-tenancy: every tenant-owned row carries `shopId` and is indexed on it.
//    Application code MUST filter every query by the session's shopId (see lib/db.ts).
//    Pure child rows (EstimateLine, InvoiceLine, Contact, PortalToken) are only ever
//    reached through an already-scoped parent, so they inherit the tenant boundary.
// 2. Money is ALWAYS an integer number of cents (`*Cents`). Never a float.
// 3. Tax rates are ALWAYS integer basis points (`*Bps`). 8.25% => 825.
// 4. Human-facing document numbers (ticket/estimate/invoice) are per-shop sequential
//    integers guarded by @@unique([shopId, number]) — see lib/sequence.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  TECH
  FRONT_DESK
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommentChannel {
  NOTE
  EMAIL
  SMS
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  OTHER
  CREDIT
}

enum CommunicationType {
  EMAIL
  SMS
}

enum CommunicationDirection {
  OUT
  IN
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Shop {
  /// ISO 4217 lower-case; two-decimal currencies only.
  currency               String                  @default("usd")
  /// Stripe Connect: the shop's own Stripe account (one-click onboarding).
  stripeAccountId        String?
  stripeOnboardedAt      DateTime?
  /// The payment-confirmation endpoint RepairFlow created on that account.
  stripeWebhookId        String?
  /// Its signing secret. SERVER ONLY — never selected into anything a client sees.
  stripeWebhookSecret    String?
  /// The URL the endpoint was created for, so a moved app is detectable.
  stripeWebhookUrl       String?
  stripeWebhookAt        DateTime?
  /// Why automatic setup did not finish, in the words the tab shows.
  stripeWebhookError     String?
  auditLogs              AuditLog[]
  taxRates               TaxRate[]
  vendors                Vendor[]
  purchaseOrders         PurchaseOrder[]
  productSerials         ProductSerial[]
  webhooks               Webhook[]
  webhookDeliveries      WebhookDelivery[]
  checklistTemplates     ChecklistTemplate[]
  integrationConnections IntegrationConnection[]
  integrationLinks       IntegrationLink[]
  deposits               Deposit[]
  timeClockEntries       TimeClockEntry[]
  cashDrawerSessions     CashDrawerSession[]
  scanSessions           ScanSession[]
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  address1               String?
  address2               String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String                  @default("US")
  phone                  String?
  email                  String?
  logoUrl                String?
  timezone               String                  @default("America/Edmonton")
  /// Default sales tax in basis points (825 = 8.25%)
  taxRateBps             Int                     @default(0)
  settings               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations         Location[]
  users             User[]
  customers         Customer[]
  assets            Asset[]
  tickets           Ticket[]
  ticketComments    TicketComment[]
  ticketCharges     TicketCharge[]
  timeEntries       TimeEntry[]
  cannedResponses   CannedResponse[]
  estimates         Estimate[]
  invoices          Invoice[]
  payments          Payment[]
  products          Product[]
  attachments       Attachment[]
  communicationLogs CommunicationLog[]
  recurringInvoices RecurringInvoice[]
  stockAdjustments  StockAdjustment[]
  campaigns         Campaign[]
  campaignSends     CampaignSend[]
  creditAdjustments CreditAdjustment[]
  apiKeys           ApiKey[]
  leads             Lead[]
  appointments      Appointment[]
  partOrders        PartOrder[]
  refunds           Refund[]
}

model Location {
  active             Boolean             @default(true)
  invoices           Invoice[]
  users              User[]
  cashDrawerSessions CashDrawerSession[]
  id                 String              @id @default(cuid())
  shopId             String
  name               String
  address1           String?
  address2           String?
  city               String?
  state              String?
  postalCode         String?
  phone              String?
  isDefault          Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  appointments Appointment[]

  @@index([shopId])
}

// Email is globally unique (a person belongs to exactly one shop) — keeps the
// login lookup a single indexed read with no tenant hint required.
model User {
  /// Set on invite; the (app) layout forces a password change before anything else.
  mustChangePassword Boolean              @default(false)
  /// Base32 TOTP secret; 2FA is enforced only once totpEnabledAt is set.
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// sha256 of each unused one-time recovery code; a code is removed once spent.
  totpRecoveryCodes  String[]             @default([])
  lastLoginAt        DateTime?
  /// Sessions issued before this instant are refused by the (app) layout.
  passwordChangedAt  DateTime?
  defaultLocationId  String?
  defaultLocation    Location?            @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  passwordResets     PasswordResetToken[]
  auditLogs          AuditLog[]
  purchaseOrders     PurchaseOrder[]
  depositsTaken      Deposit[]
  timeClockEntries   TimeClockEntry[]
  drawersOpened      CashDrawerSession[]  @relation("DrawerOpenedBy")
  drawersClosed      CashDrawerSession[]  @relation("DrawerClosedBy")
  scanSessions       ScanSession[]
  id                 String               @id @default(cuid())
  shopId             String
  email              String               @unique
  passwordHash       String
  name               String
  role               Role                 @default(TECH)
  active             Boolean              @default(true)

  // --- Sign in with Google (staff only; the customer portal uses magic links) ---
  /// Google's `sub`: the stable account id, and the identity a Google sign-in
  /// is matched on. Globally unique for the same reason `email` is — one
  /// Google account signs into exactly one RepairFlow user.
  googleSub          String?              @unique
  /// The Google address that was linked, kept for display. Usually equal to
  /// `email`, but an owner can change `email` afterwards and a person may link
  /// a personal Google account to a work address, so it is stored separately.
  googleEmail        String?
  googleLinkedAt     DateTime?
  /// Google's `picture` claim. Remote URL; nothing is downloaded.
  avatarUrl          String?
  /// False once an account exists that its owner has never chosen a password
  /// for — a Google signup, or an invite accepted with Google. It is what
  /// stops "Disconnect" from locking someone out of their own shop.
  hasPassword        Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedTickets   Ticket[]
  comments          TicketComment[]
  timeEntries       TimeEntry[]
  paymentsTaken     Payment[]
  attachments       Attachment[]
  stockAdjustments  StockAdjustment[]
  creditAdjustments CreditAdjustment[]
  appointments      Appointment[]
  refunds           Refund[]

  @@index([shopId])
  @@index([shopId, role])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Customer {
  taxExempt             Boolean   @default(false)
  taxRateId             String?
  taxRate               TaxRate?  @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  /// Card on file (Stripe). Only display fields live here; the card lives at Stripe.
  stripeCustomerId      String?
  stripePaymentMethodId String?
  cardBrand             String?
  cardLast4             String?
  cardExpMonth          Int?
  cardExpYear           Int?
  deposits              Deposit[]
  id                    String    @id @default(cuid())
  shopId                String
  firstName             String
  lastName              String
  businessName          String?
  email                 String?
  phone                 String?
  mobile                String?
  address1              String?
  address2              String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String    @default("US")
  notes                 String?
  smsOptIn              Boolean   @default(false)
  emailOptIn            Boolean   @default(true)
  /// Store credit held for this customer, in cents.
  creditBalanceCents    Int       @default(0)
  referredBy            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  contacts          Contact[]
  assets            Asset[]
  tickets           Ticket[]
  estimates         Estimate[]
  invoices          Invoice[]
  attachments       Attachment[]
  communicationLogs CommunicationLog[]
  portalTokens      PortalToken[]
  recurringInvoices RecurringInvoice[]
  campaignSends     CampaignSend[]
  creditAdjustments CreditAdjustment[]
  leads             Lead[]
  appointments      Appointment[]

  @@index([shopId, lastName])
  @@index([shopId, createdAt])
  @@index([shopId, email])
  @@index([shopId, phone])
}

model Contact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  email      String?
  phone      String?
  label      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// A device belonging to a customer (laptop, phone, console...).
model Asset {
  id         String  @id @default(cuid())
  shopId     String
  customerId String
  type       String
  make       String?
  model      String?
  serial     String?
  /// Device unlock code / password captured at intake.
  password   String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@index([shopId])
  @@index([customerId])
  @@index([shopId, serial])
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

/// status is a free-form string so shops can add their own workflow states.
/// Built-ins: New | In Progress | Waiting for Parts | Waiting on Customer |
///            Ready for Pickup | Resolved
model Ticket {
  /// "staff" | "checkin" | "portal" | "email" | "sms" | "api"
  source                 String             @default("staff")
  isWarranty             Boolean            @default(false)
  warrantyInvoiceLineId  String?
  warrantyInvoiceLine    InvoiceLine?       @relation(fields: [warrantyInvoiceLineId], references: [id], onDelete: SetNull)
  /// [{ label: string, done: boolean, doneAt?: string }]
  checklist              Json?
  checklistTemplateId    String?
  checklistTemplate      ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  /// SLA: stamped once when dueDate passes; slaNotifiedAt gates the single alert.
  slaBreachedAt          DateTime?
  slaNotifiedAt          DateTime?
  /// Last customer-originated message (portal / inbound email / SMS).
  lastInboundAt          DateTime?
  /// Sum of deposits taken against this ticket (cents); each is a Deposit row.
  depositCents           Int                @default(0)
  deposits               Deposit[]
  pickedUpAt             DateTime?
  /// Stamped once the post-pickup review request has gone out (lib/jobs/reviews.ts).
  reviewRequestedAt      DateTime?
  id                     String             @id @default(cuid())
  shopId                 String
  locationId             String?
  customerId             String
  assetId                String?
  /// Per-shop sequential ticket number shown to humans.
  number                 Int
  subject                String
  problemType            String
  status                 String             @default("New")
  priority               Priority           @default(NORMAL)
  assignedToId           String?
  dueDate                DateTime?
  diagnosticNotes        String?
  customFields           Json?
  intakeSignatureDataUrl String?
  intakeSignedAt         DateTime?
  resolvedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assignedTo        User?              @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  comments          TicketComment[]
  charges           TicketCharge[]
  timeEntries       TimeEntry[]
  estimates         Estimate[]
  invoices          Invoice[]
  attachments       Attachment[]
  communicationLogs CommunicationLog[]
  campaignSends     CampaignSend[]
  leads             Lead[]
  appointments      Appointment[]
  partOrders        PartOrder[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, assignedToId])
  @@index([shopId, createdAt])
}

/// isPublic = true means the comment is customer-visible and (for EMAIL/SMS
/// channels) would be delivered to them. Private notes stay internal.
model TicketComment {
  id         String         @id @default(cuid())
  shopId     String
  ticketId   String
  authorId   String?
  body       String
  isPublic   Boolean        @default(false)
  subject    String?
  updateType String?
  channel    CommentChannel @default(NOTE)

  createdAt DateTime @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([shopId, createdAt])
}

model CannedResponse {
  id     String @id @default(cuid())
  shopId String
  title  String
  body   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

/// Labour or parts line accrued on a ticket. `invoiceId` is set once the charge
/// has been pulled onto an invoice, so un-invoiced work is `invoiceId: null`.
model TicketCharge {
  id             String  @id @default(cuid())
  shopId         String
  ticketId       String
  productId      String?
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  taxable        Boolean @default(true)
  invoiceId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([ticketId])
  @@index([invoiceId])
}

model TimeEntry {
  billable  Boolean   @default(true)
  /// Set once billed as a labour line on this invoice.
  invoiceId String?
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  id        String    @id @default(cuid())
  shopId    String
  ticketId  String
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  /// Denormalised duration; set when the entry is stopped.
  seconds   Int?
  note      String?

  createdAt DateTime @default(now())

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([shopId, userId])
  @@index([shopId, startedAt])
}

// ---------------------------------------------------------------------------
// Estimates / Invoices / Payments
// ---------------------------------------------------------------------------

model Estimate {
  taxRateId                String?
  taxRate                  TaxRate?       @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  id                       String         @id @default(cuid())
  shopId                   String
  customerId               String
  ticketId                 String?
  number                   Int
  status                   EstimateStatus @default(DRAFT)
  /// Snapshot of the tax rate at creation time, in basis points.
  taxRateBps               Int            @default(0)
  notes                    String?
  expiresAt                DateTime?
  approvedAt               DateTime?
  approvalSignatureDataUrl String?
  /// Unguessable token for the public customer-portal link.
  publicToken              String         @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket   Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  lines    EstimateLine[]
  invoices Invoice[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, customerId])
}

model EstimateLine {
  id             String  @id @default(cuid())
  estimateId     String
  productId      String?
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  taxable        Boolean @default(true)
  sortOrder      Int     @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

/// Totals (subtotal / tax / total / balance) are computed in code from the lines
/// and payments — see lib/money.ts calcTotals(). Nothing is denormalised here so
/// a line edit can never desync from a stored total.
model Invoice {
  locationId         String?
  location           Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  taxRateId          String?
  taxRate            TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  timeEntries        TimeEntry[]
  depositsApplied    Deposit[]
  id                 String        @id @default(cuid())
  shopId             String
  customerId         String
  ticketId           String?
  estimateId         String?
  /// Set when this invoice was generated from a recurring schedule.
  recurringInvoiceId String?
  number             Int
  status             InvoiceStatus @default(DRAFT)
  taxRateBps         Int           @default(0)
  notes              String?
  dueDate            DateTime?
  publicToken        String        @unique @default(cuid())
  paidAt             DateTime?
  signatureDataUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket            Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  estimate          Estimate?          @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  recurringInvoice  RecurringInvoice?  @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  lines             InvoiceLine[]
  payments          Payment[]
  ticketCharges     TicketCharge[]
  communicationLogs CommunicationLog[]
  campaignSends     CampaignSend[]
  refunds           Refund[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([shopId, customerId])
  @@index([shopId, createdAt])
}

model InvoiceLine {
  /// Snapshot of Product.warrantyDays at sale time; null = no warranty.
  warrantyDays    Int?
  warrantyTickets Ticket[]
  productSerials  ProductSerial[]
  id              String          @id @default(cuid())
  invoiceId       String
  productId       String?
  description     String
  quantity        Int             @default(1)
  unitPriceCents  Int
  taxable         Boolean         @default(true)
  /// Serial number of the physical unit sold, when applicable.
  serial          String?
  sortOrder       Int             @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  stripePaymentIntentId String?
  stripeChargeId        String?
  /// "checkout" | "terminal" | "card_on_file" | null (manual)
  stripeSource          String?
  id                    String        @id @default(cuid())
  shopId                String
  invoiceId             String
  amountCents           Int
  method                PaymentMethod @default(CARD)
  reference             String?
  takenById             String?

  createdAt DateTime @default(now())

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  takenBy User?    @relation(fields: [takenById], references: [id], onDelete: SetNull)
  refunds Refund[]

  @@index([invoiceId])
  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Product {
  reorderQty    Int?
  warrantyDays  Int?
  vendorId      String?
  vendor        Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorSku     String?
  /// When true each unit is a ProductSerial row; stockQty mirrors IN_STOCK units.
  serialized    Boolean             @default(false)
  serials       ProductSerial[]
  purchaseLines PurchaseOrderLine[]
  id            String              @id @default(cuid())
  shopId        String
  name          String
  sku           String?
  upc           String?
  description   String?
  priceCents    Int                 @default(0)
  costCents     Int?
  taxable       Boolean             @default(true)
  stockQty      Int                 @default(0)
  /// Reorder threshold; null disables low-stock alerts for this product.
  lowStockAt    Int?
  category      String?
  active        Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketCharges  TicketCharge[]
  estimateLines  EstimateLine[]
  invoiceLines   InvoiceLine[]
  recurringLines RecurringInvoiceLine[]
  adjustments    StockAdjustment[]
  partOrders     PartOrder[]

  @@unique([shopId, sku])
  @@index([shopId, name])
  @@index([shopId, category])
}

// ---------------------------------------------------------------------------
// Files & communications
// ---------------------------------------------------------------------------

/// `path` is a public-relative path under /public/uploads for now; swapping to
/// object storage later only changes how `path` is resolved.
model Attachment {
  /// "local" | "s3"
  storage      String  @default("local")
  id           String  @id @default(cuid())
  shopId       String
  ticketId     String?
  customerId   String?
  uploadedById String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  path         String

  createdAt DateTime @default(now())

  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([ticketId])
  @@index([customerId])
}

model CommunicationLog {
  providerMessageId String?
  id                String                 @id @default(cuid())
  shopId            String
  customerId        String
  ticketId          String?
  invoiceId         String?
  type              CommunicationType
  direction         CommunicationDirection @default(OUT)
  to                String
  subject           String?
  body              String
  status            String                 @default("logged")

  createdAt DateTime @default(now())

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket   Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([customerId])
  @@index([ticketId])
}

/// Magic-link token for the customer portal (Phase 2).
model PortalToken {
  id         String    @id @default(cuid())
  customerId String
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — recurring billing + stock audit trail
// ---------------------------------------------------------------------------

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A billing schedule that stamps out DRAFT invoices on a cadence
/// (business contracts, managed-service retainers).
model RecurringInvoice {
  taxRateId       String?
  taxRate         TaxRate?           @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  /// Charge the card on file when the invoice is generated.
  autoCharge      Boolean            @default(false)
  /// Email the invoice automatically when generated.
  autoSend        Boolean            @default(false)
  lastChargeError String?
  id              String             @id @default(cuid())
  shopId          String
  customerId      String
  name            String
  frequency       RecurringFrequency @default(MONTHLY)
  /// Next date an invoice should be generated for this schedule.
  nextRunAt       DateTime
  /// Day of the month this schedule is anchored to, 1-31.
  ///
  /// Stored, not re-derived from nextRunAt, because a month shorter than the
  /// anchor clamps the run date — and re-deriving from the clamped result
  /// loses the anchor for good: 31 Jan -> 28 Feb -> 28 Mar -> 28 Apr, three
  /// days early every month after the first February. Null on WEEKLY
  /// schedules, which have no month-day anchor at all.
  anchorDay       Int?
  lastRunAt       DateTime?
  active          Boolean            @default(true)
  taxRateBps      Int                @default(0)
  /// Generated invoices get dueDate = created + dueInDays.
  dueInDays       Int                @default(14)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines    RecurringInvoiceLine[]
  invoices Invoice[]

  @@index([shopId, active])
  @@index([nextRunAt])
}

model RecurringInvoiceLine {
  id                 String  @id @default(cuid())
  recurringInvoiceId String
  productId          String?
  description        String
  quantity           Int     @default(1)
  unitPriceCents     Int
  taxable            Boolean @default(true)
  sortOrder          Int     @default(0)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recurringInvoiceId])
}

/// Audit trail for every stock change (received, sold, counted, damaged).
/// Product.stockQty is the cached current level; adjustments are the history.
model StockAdjustment {
  id        String  @id @default(cuid())
  shopId    String
  productId String
  /// Signed change: +5 received, -1 sold.
  delta     Int
  reason    String
  userId    String?

  createdAt DateTime @default(now())

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, productId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 — marketing automations, credit audit, public API
// ---------------------------------------------------------------------------

enum CampaignTrigger {
  TICKET_RESOLVED
  INVOICE_PAID
  CUSTOMER_CREATED
}

/// A follow-up automation ("Marketr"): when <trigger> happens, message the
/// customer <delayDays> later over <channel>.
model Campaign {
  id        String            @id @default(cuid())
  shopId    String
  name      String
  trigger   CampaignTrigger
  delayDays Int               @default(14)
  channel   CommunicationType @default(EMAIL)
  subject   String?
  /// Message body; supports {{firstName}} {{shopName}} {{ticketNumber}} {{invoiceNumber}} placeholders.
  body      String
  active    Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop  Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sends CampaignSend[]

  @@index([shopId, active])
}

/// One scheduled/sent message a campaign produced for one qualifying event.
/// Dedupe rule (enforced in code): one send per (campaign, source event).
model CampaignSend {
  id          String    @id @default(cuid())
  shopId      String
  campaignId  String
  customerId  String
  ticketId    String?
  invoiceId   String?
  scheduledAt DateTime
  sentAt      DateTime?
  /// scheduled | sent | skipped: <reason> | failed: <reason>
  status      String    @default("scheduled")

  createdAt DateTime @default(now())

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket   Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([shopId, status, scheduledAt])
  @@index([campaignId, customerId])
}

/// Audit trail for store-credit changes; Customer.creditBalanceCents is the
/// cached level, these rows are the history.
model CreditAdjustment {
  id         String  @id @default(cuid())
  shopId     String
  customerId String
  /// Signed change in cents: +5000 granted, -2000 spent/removed.
  deltaCents Int
  reason     String
  userId     String?

  createdAt DateTime @default(now())

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, customerId, createdAt])
}

/// Bearer key for the public REST API. Only a hash is stored; `prefix` is the
/// first 8 chars kept for display ("rfk_ab12…").
model ApiKey {
  id         String    @id @default(cuid())
  shopId     String
  name       String
  keyHash    String    @unique
  prefix     String
  active     Boolean   @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

// ---------------------------------------------------------------------------
// Phase 5 — parity: leads, appointments, parts ordering, refunds
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

/// An inquiry that isn't a customer yet (walk-in quote request, web form,
/// phone call). Converting creates/links a Customer and optionally a Ticket.
model Lead {
  id         String     @id @default(cuid())
  shopId     String
  name       String
  email      String?
  phone      String?
  source     String?
  message    String?
  status     LeadStatus @default(NEW)
  customerId String?
  ticketId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticket   Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([shopId, createdAt])
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELED
}

/// A scheduled visit: drop-off, pickup, on-site/field job, callback.
model Appointment {
  reminderSentAt DateTime?
  id             String            @id @default(cuid())
  shopId         String
  customerId     String?
  ticketId       String?
  assignedToId   String?
  locationId     String?
  title          String
  notes          String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([shopId, startsAt])
  @@index([shopId, assignedToId, startsAt])
}

enum PartOrderStatus {
  NEEDED
  ORDERED
  RECEIVED
  CANCELED
}

/// A part that must be sourced for a ticket ("Part Order / Parts Status").
/// Receiving one can increment Product stock via a StockAdjustment.
model PartOrder {
  vendorId        String?
  vendor          Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  id              String          @id @default(cuid())
  shopId          String
  ticketId        String
  productId       String?
  description     String
  supplier        String?
  quantity        Int             @default(1)
  costCents       Int?
  status          PartOrderStatus @default(NEEDED)
  expectedAt      DateTime?
  orderedAt       DateTime?
  receivedAt      DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([ticketId])
}

/// Money returned against an invoice. Kept separate from Payment so payment
/// history stays append-only and reports can distinguish flows.
model Refund {
  stripeRefundId String?
  /// "completed" | "pending" | "failed"
  status         String        @default("completed")
  id             String        @id @default(cuid())
  shopId         String
  invoiceId      String
  paymentId      String?
  amountCents    Int
  method         PaymentMethod @default(CARD)
  reason         String?
  refundedById   String?

  createdAt DateTime @default(now())

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundedBy User?    @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Wave 8 — security, locations, tax, vendors/POs, serials, webhooks,
//          checklists, deposits, time clock, cash drawer, accounting sync
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// sha256 of the token in the emailed link; the plaintext is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Who did what. Written by lib/audit.ts; never edited or deleted from the app.
model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  userId    String?
  /// dotted verb: "user.login", "user.role_changed", "ticket.deleted", "settings.updated"
  action    String
  /// "user" | "ticket" | "invoice" | "customer" | "settings" | "api_key" | ...
  entity    String
  entityId  String?
  summary   String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, entity, entityId])
}

model TaxRate {
  id                String             @id @default(cuid())
  shopId            String
  name              String
  rateBps           Int
  isDefault         Boolean            @default(false)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customers         Customer[]
  estimates         Estimate[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]

  @@index([shopId, active])
}

model Vendor {
  id             String          @id @default(cuid())
  shopId         String
  name           String
  email          String?
  phone          String?
  website        String?
  accountNumber  String?
  address        String?
  notes          String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  partOrders     PartOrder[]

  @@index([shopId, name])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELED
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  shopId        String
  vendorId      String
  /// Per-shop sequential PO number (lib/sequence.ts).
  number        Int
  status        PurchaseOrderStatus @default(DRAFT)
  shippingCents Int                 @default(0)
  notes         String?
  orderedAt     DateTime?
  expectedAt    DateTime?
  receivedAt    DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         PurchaseOrderLine[]
  partOrders    PartOrder[]

  @@unique([shopId, number])
  @@index([shopId, status])
  @@index([vendorId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Int           @default(1)
  receivedQty     Int           @default(0)
  unitCostCents   Int           @default(0)
  sortOrder       Int           @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  DEFECTIVE
}

/// One physical unit of a serialized product.
model ProductSerial {
  id            String       @id @default(cuid())
  shopId        String
  productId     String
  serial        String
  status        SerialStatus @default(IN_STOCK)
  invoiceLineId String?
  receivedAt    DateTime     @default(now())
  soldAt        DateTime?
  notes         String?
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@unique([shopId, productId, serial])
  @@index([shopId, status])
  @@index([shopId, serial])
}

/// Outbound webhook subscription. `secret` signs every delivery (HMAC-SHA256).
model Webhook {
  id         String            @id @default(cuid())
  shopId     String
  url        String
  secret     String
  /// e.g. ["ticket.created", "invoice.paid"]; "*" subscribes to everything.
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([shopId, active])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  shopId        String
  webhookId     String
  event         String
  payload       Json
  /// "pending" | "delivered" | "failed"
  status        String    @default("pending")
  attempts      Int       @default(0)
  responseCode  Int?
  lastError     String?
  lastAttemptAt DateTime?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([shopId, status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

/// A reusable ticket checklist ("Phone intake: check screen, test buttons...").
model ChecklistTemplate {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  /// Optional: auto-attach when a ticket with this problem type is created.
  problemType String?
  /// string[]
  items       Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([shopId, active])
}

/// OAuth connection to an accounting provider ("quickbooks" | "xero").
model IntegrationConnection {
  id               String    @id @default(cuid())
  shopId           String
  provider         String
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  /// QuickBooks realmId / Xero tenantId
  remoteTenantId   String?
  remoteTenantName String?
  /// "connected" | "error" | "disconnected"
  status           String    @default("connected")
  lastSyncAt       DateTime?
  lastError        String?
  settings         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider])
}

/// Maps a local row to its remote id in an accounting provider.
model IntegrationLink {
  id       String   @id @default(cuid())
  shopId   String
  provider String
  /// "customer" | "invoice" | "payment" | "product"
  entity   String
  entityId String
  remoteId String
  /// Provider bookkeeping for this row — QuickBooks SyncToken, Xero UpdatedDateUTC,
  /// the DisplayName we had to disambiguate. Never business data.
  meta     Json?
  syncedAt DateTime @default(now())
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider, entity, entityId])
  @@index([shopId, provider, entity])
}

/// Money taken up front against a ticket. Credited to the customer's store
/// credit (with a CreditAdjustment) so the final invoice can absorb it via the
/// CREDIT tender; `appliedInvoiceId` records where it ended up.
model Deposit {
  id               String        @id @default(cuid())
  shopId           String
  ticketId         String
  customerId       String
  amountCents      Int
  method           PaymentMethod @default(CARD)
  reference        String?
  takenById        String?
  appliedInvoiceId String?
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticket           Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  takenBy          User?         @relation(fields: [takenById], references: [id], onDelete: SetNull)
  appliedInvoice   Invoice?      @relation(fields: [appliedInvoiceId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([ticketId])
}

/// Staff clock in / clock out.
model TimeClockEntry {
  id         String    @id @default(cuid())
  shopId     String
  userId     String
  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?
  note       String?
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, userId, clockInAt])
  @@index([shopId, clockInAt])
}

/// A cash drawer shift: opened with a float, closed with a count.
model CashDrawerSession {
  id            String    @id @default(cuid())
  shopId        String
  locationId    String?
  openedById    String
  openedAt      DateTime  @default(now())
  openingCents  Int       @default(0)
  closedById    String?
  closedAt      DateTime?
  /// Computed at close: opening + cash payments + cash deposits - cash refunds.
  expectedCents Int?
  countedCents  Int?
  note          String?
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  openedBy      User      @relation("DrawerOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  closedBy      User?     @relation("DrawerClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([shopId, openedAt])
}

// ---------------------------------------------------------------------------
// Phone-as-scanner
// ---------------------------------------------------------------------------

/// A till that has asked a phone to scan on its behalf.
///
/// The desktop register creates one of these, prints its `code` as a QR, and
/// then polls for the events the phone posts into it. The pairing is scoped to
/// ONE shop and ONE user: the phone must be signed in as the same person who
/// opened the dialog, so a scan can never cross a tenant or land on a
/// colleague's till (see lib/db.ts).
///
/// `code` is the short pairing string. It is single-use — `pairedAt` is stamped
/// the first time a phone claims it — and the whole row dies at `expiresAt`,
/// about half an hour after it was made. Housekeeping sweeps the corpses.
model ScanSession {
  id        String    @id @default(cuid())
  shopId    String
  userId    String
  /// Short, unambiguous pairing code (Crockford-ish alphabet, no O/0/I/1).
  code      String    @unique
  /// What the phone is feeding, e.g. "Register" — shown on both ends.
  label     String    @default("Register")
  /// Stamped when a phone claims the code. A second claim is refused.
  pairedAt  DateTime?
  /// Stamped when either end disconnects. An ended session accepts nothing.
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  shop   Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ScanEvent[]

  @@index([shopId, expiresAt])
  @@index([userId, createdAt])
}

/// One barcode the paired phone read.
///
/// `seq` is the poll cursor: the till asks for everything after the last `seq`
/// it consumed, which makes the transport exactly-once without the till having
/// to acknowledge each row individually. `consumedAt` records that it did.
model ScanEvent {
  id         String    @id @default(cuid())
  seq        Int       @unique @default(autoincrement())
  sessionId  String
  /// Denormalised from the session so the tenant filter never needs a join.
  shopId     String
  value      String
  /// The symbology the phone decoded, e.g. "EAN-13". Informational.
  format     String?
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  session ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@index([shopId, createdAt])
}
