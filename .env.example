# RepairFlow environment
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Everything is optional except DATABASE_URL and
# AUTH_SECRET; each integration is OFF until its variables are present, and a
# missing value removes a feature rather than half-enabling one.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://user@localhost:5432/repairshop"
# Signs the session cookie AND the Stripe Connect OAuth `state`. Any long random string.
AUTH_SECRET="change-me-to-something-long-and-random"
# The origin every customer-facing link and OAuth redirect is built from.
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# --- Card payments (Stripe) -------------------------------------------------
# The platform secret key. Its absence is the single switch that turns every
# pay button off. sk_test_… enables simulated card readers.
STRIPE_SECRET_KEY=
# Connect OAuth application id (ca_…), from Stripe → Settings → Connect.
# Required for the one-click "Connect with Stripe" button in Settings → Payments.
STRIPE_CLIENT_ID=
# Signing secret for POST /api/webhooks/stripe. WITHOUT IT, CUSTOMERS CAN PAY
# AND INVOICES NEVER UPDATE — every confirmation is rejected at the door.
# Register the endpoint twice in Stripe: once normally, once under Connect.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         payment_intent.succeeded, charge.refunded, refund.updated,
#         account.application.deauthorized
STRIPE_WEBHOOK_SECRET=
# off | stripe. Defaults to stripe once STRIPE_SECRET_KEY is set; anything
# unrecognised resolves to off.
PAYMENTS_DRIVER=
# ISO 4217, lowercase. Two-decimal currencies only — amounts are stored in cents.
PAYMENTS_CURRENCY=usd

# --- Development only: the fake Stripe ---------------------------------------
# `node scripts/dev/fake-stripe.mjs` implements the endpoints lib/payments calls
# and fires signed webhooks back, so every payment flow can be exercised without
# live keys. Leave all three UNSET in production.
#   STRIPE_API_BASE=http://localhost:4242
#   STRIPE_CONNECT_BASE=http://localhost:4242   # defaults to STRIPE_API_BASE
#   NEXT_PUBLIC_STRIPE_TERMINAL_JS=http://localhost:4242/terminal/v1/
STRIPE_API_BASE=
STRIPE_CONNECT_BASE=
NEXT_PUBLIC_STRIPE_TERMINAL_JS=

# --- Email ------------------------------------------------------------------
# log (default — prints to the console) | resend
EMAIL_DRIVER=
RESEND_API_KEY=
EMAIL_FROM=

# --- SMS --------------------------------------------------------------------
# log (default) | twilio
SMS_DRIVER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Background jobs --------------------------------------------------------
# In-app timer: how often it runs, and how long it waits after boot.
JOBS_INTERVAL_MIN=15
JOBS_FIRST_DELAY_S=60
# Shared secret for GET|POST /api/cron. Unset means that endpoint answers 503.
CRON_SECRET=

# --- AI assist --------------------------------------------------------------
# off (default) | anthropic | ollama
AI_DRIVER=
AI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_URL=
