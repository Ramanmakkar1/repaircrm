# RepairFlow — copy to .env and fill in what you need.
# Everything below is optional except DATABASE_URL and AUTH_SECRET.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://user@localhost:5432/repairshop"
# Signs the session cookie and every OAuth `state`. Any long random string.
AUTH_SECRET="change-me-to-something-long-and-random"
# Absolute origin. Customer portal links and OAuth redirect URIs are built
# from this, so it must be your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# --- Outbound messaging (lib/comms/config.ts) -------------------------------
# Unset = "log": messages are printed and filed in the outbox, never sent.
EMAIL_DRIVER="log"          # log | resend
RESEND_API_KEY=""
EMAIL_FROM=""
SMS_DRIVER="log"            # log | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Online card payments (lib/payments/config.ts) ---------------------------
# Setting STRIPE_SECRET_KEY alone switches payments on.
PAYMENTS_DRIVER=""          # off | stripe (default: stripe iff the key is set)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENTS_CURRENCY="usd"     # two-decimal currencies only

# --- Accounting integrations (lib/integrations/config.ts) -------------------
# QuickBooks Online. Register the redirect URI shown on the Integrations tab:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/quickbooks/callback
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"   # sandbox | production

# Xero. Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/xero/callback
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Provider hosts. Leave these unset in production — the documented Intuit and
# Xero endpoints are used. They exist so scripts/dev/fake-quickbooks.mjs and
# scripts/dev/fake-xero.mjs can stand in for the real thing locally.
# QBO_AUTH_BASE="http://127.0.0.1:4310"
# QBO_OAUTH_BASE="http://127.0.0.1:4310"
# QBO_REVOKE_BASE="http://127.0.0.1:4310"
# QBO_API_BASE="http://127.0.0.1:4310"
# XERO_LOGIN_BASE="http://127.0.0.1:4311"
# XERO_IDENTITY_BASE="http://127.0.0.1:4311"
# XERO_API_BASE="http://127.0.0.1:4311"

# --- Automation (instrumentation.ts, app/api/cron) --------------------------
JOBS_INTERVAL_MIN="15"
JOBS_FIRST_DELAY_S="60"
# Shared secret for GET|POST /api/cron. Unset = the endpoint answers 503.
CRON_SECRET=""

# --- AI assist (lib/ai/config.ts) -------------------------------------------
AI_DRIVER=""                # off | anthropic | ollama
AI_MODEL=""
ANTHROPIC_API_KEY=""
OLLAMA_URL=""
