# RepairFlow — environment
#
# Copy to `.env` and fill in what you need. EVERY INTEGRATION FAILS CLOSED:
# leave a section blank and that feature is off, not half-on. Nothing here is
# read at build time except NEXT_PUBLIC_APP_URL, which is baked into the client
# bundle — change it and rebuild.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://user@localhost:5432/repairshop"

# Signs the staff session cookie AND the customer-portal cookie. Rotating it
# signs everyone out. Generate with: openssl rand -hex 32
AUTH_SECRET=""

# The absolute origin customer-facing links are built from, and the origin
# Twilio's inbound signature is checked against. Set it to your real domain
# before going live or customers receive links pointing at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# ---------------------------------------------------------------------------
# Outbound messaging  (lib/comms)
# ---------------------------------------------------------------------------
# Unset -> "log": messages are printed to the server console and filed in the
# outbox, but nothing leaves the building. The safe default for staging.

EMAIL_DRIVER="log"          # log | resend
RESEND_API_KEY=""
EMAIL_FROM=""               # "Your Shop <hello@yourshop.com>"

SMS_DRIVER="log"            # log | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""              # the number you send from, e.g. +17805550100

# ---------------------------------------------------------------------------
# Inbound email & SMS  (app/api/inbound)
# ---------------------------------------------------------------------------
# Customer replies become a public comment on their ticket. Both endpoints
# REFUSE every request until their secret is set — an inbound route that trusts
# anything lets a stranger write on a customer's ticket.
#
#   POST /api/inbound/email   Resend inbound (Svix-signed), or the generic JSON
#                             form guarded by ?token=INBOUND_SECRET
#   POST /api/inbound/sms     Twilio, verified with TWILIO_AUTH_TOKEN above
#
# Set the shop's inbound address in Settings → Messaging → Inbound so a message
# can be matched to the right tenant.

RESEND_WEBHOOK_SECRET=""    # "whsec_…" from the Resend inbound webhook
INBOUND_SECRET=""           # any long random string; used as ?token=

# ---------------------------------------------------------------------------
# File storage  (lib/storage)
# ---------------------------------------------------------------------------
# "local" writes to public/uploads on this machine — right for a single box,
# wrong for anything with more than one instance or an ephemeral filesystem.
# "s3" speaks plain S3 with SigV4 and works against AWS, Cloudflare R2, MinIO
# and Backblaze B2. Existing rows record which driver wrote them, so switching
# strands nothing.

STORAGE_DRIVER="local"      # local | s3
S3_BUCKET=""
S3_REGION=""                # "us-east-1"; use "auto" for Cloudflare R2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""              # only for non-AWS, e.g. http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=""      # "true" for MinIO and most self-hosted gateways

# ---------------------------------------------------------------------------
# Card payments  (lib/payments)
# ---------------------------------------------------------------------------
# Without STRIPE_WEBHOOK_SECRET customers CAN pay and the invoice never
# updates — Stripe's confirmation is rejected at the door. Set both or neither.

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENTS_CURRENCY="usd"     # two-decimal currencies only

# ---------------------------------------------------------------------------
# Automation  (lib/jobs)
# ---------------------------------------------------------------------------
# Recurring invoices, campaign sends, outbound webhook delivery and
# housekeeping. An in-app timer runs them; CRON_SECRET additionally opens
# GET|POST /api/cron for an external scheduler. Unset -> that endpoint 503s.

CRON_SECRET=""
JOBS_INTERVAL_MIN="15"
JOBS_FIRST_DELAY_S="60"

# ---------------------------------------------------------------------------
# AI assist  (lib/ai) — optional
# ---------------------------------------------------------------------------

# Default "off" on purpose: these drivers are the only place RepairFlow sends
# ticket text to a third party, so it has to be an explicit decision.
AI_DRIVER="off"             # off | anthropic | ollama
AI_MODEL=""                 # provider-specific; each driver has a default
ANTHROPIC_API_KEY=""
OLLAMA_URL=""               # default http://localhost:11434
