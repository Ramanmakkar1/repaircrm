# RepairPilot environment
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. DATABASE_URL and AUTH_SECRET are required for
# direct local development; Docker Compose also requires POSTGRES_PASSWORD.
# Each integration is OFF until configured, so a missing value removes a
# feature rather than half-enabling one.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://user@localhost:5432/repairpilot"
# Required by Docker Compose. Generate a URI-safe value with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# Signs the session cookie AND the Stripe Connect OAuth `state`. Any long random string.
AUTH_SECRET="change-me-to-something-long-and-random"
# The origin every customer-facing link and OAuth redirect is built from.
APP_URL="http://localhost:3020"
NEXT_PUBLIC_APP_URL="http://localhost:3020"

# --- Card payments (Stripe) -------------------------------------------------
# The platform secret key. Its absence is the single switch that turns every
# pay button off. sk_test_… enables simulated card readers.
STRIPE_SECRET_KEY=
# Connect OAuth application id (ca_…), from Stripe → Settings → Connect.
# Required for the one-click "Connect with Stripe" button in Settings → Payments.
STRIPE_CLIENT_ID=
# Signing secret for direct platform-mode payments at POST /api/webhooks/stripe.
# Connected shops' signing secrets are created and stored per shop after OAuth.
# Connected-shop webhook endpoints are created automatically after OAuth.
# For direct platform payments only, register the platform webhook manually and
# use its signing secret here. Keep PAYMENTS_DRIVER=off until test checks pass.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         payment_intent.succeeded, charge.refunded, refund.updated,
#         account.application.deauthorized
STRIPE_WEBHOOK_SECRET=
# off | stripe. Defaults to stripe once STRIPE_SECRET_KEY is set; anything
# unrecognised resolves to off.
PAYMENTS_DRIVER=off
# ISO 4217, lowercase. Two-decimal currencies only — amounts are stored in cents.
PAYMENTS_CURRENCY=usd

# --- Development only: the fake Stripe ---------------------------------------
# `node scripts/dev/fake-stripe.mjs` implements the endpoints lib/payments calls
# and fires signed webhooks back, so every payment flow can be exercised without
# live keys. Leave all three UNSET in production.
#   STRIPE_API_BASE=http://localhost:4242
#   STRIPE_CONNECT_BASE=http://localhost:4242   # defaults to STRIPE_API_BASE
#   NEXT_PUBLIC_STRIPE_TERMINAL_JS=http://localhost:4242/terminal/v1/
STRIPE_API_BASE=
STRIPE_CONNECT_BASE=
NEXT_PUBLIC_STRIPE_TERMINAL_JS=

# --- Card payments (Square) -------------------------------------------------
# Create one RepairPilot application in the Square Developer Console. Shops
# then press Connect with Square and sign in; they never paste their own token.
# Remains disabled until explicitly set to `square` after sandbox testing.
SQUARE_DRIVER=off
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
# Signature key for https://your-app/api/webhooks/square.
# Events: payment.updated, terminal.checkout.updated
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Development/test endpoint overrides. Leave unset in production.
SQUARE_API_BASE=
SQUARE_OAUTH_BASE=

# --- Sign in with Google (staff accounts) -----------------------------------
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console → APIs & Services → Credentials, and register this EXACT redirect URI
# under "Authorised redirect URIs" — it must match character for character:
#
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#
# e.g. http://localhost:3020/api/auth/google/callback in development.
#
# No API needs enabling: the app only asks for `openid email profile`, which is
# the OpenID Connect scope every OAuth client has.
#
# FAIL CLOSED. With either value missing the "Continue with Google" button does
# not render on any screen and both routes refuse — no half-configured state.
#
# STAFF ONLY. Customers reach the portal through the magic links in the emails
# they already get; they never need a Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only: the fake Google. `node scripts/dev/fake-google.mjs` mints
# real RS256 id_tokens from a key pair it publishes at its own JWKS endpoint,
# so the whole flow — PKCE, signature, iss, aud, exp, nonce — can be exercised
# without Google credentials. Leave all three UNSET in production, and the
# documented Google endpoints are used.
#   GOOGLE_AUTH_BASE="http://127.0.0.1:4320"
#   GOOGLE_TOKEN_URL="http://127.0.0.1:4320/token"
#   GOOGLE_JWKS_URL="http://127.0.0.1:4320/oauth2/v3/certs"
GOOGLE_AUTH_BASE=
GOOGLE_TOKEN_URL=
GOOGLE_JWKS_URL=

# --- Platform operations metrics -------------------------------------------
# Optional read-only provider metrics for the /platform operations console.
# Cloudflare: create a token with only Account Analytics: Read and scope it to
# the RepairPilot account. For Workers, set the token as a secret.
CLOUDFLARE_ACCOUNT_ID=
CF_WORKER_NAME=repairpilot
CF_ANALYTICS_API_TOKEN=
# Displayed in the read-only platform console. This is an operating policy,
# not a provider-side hard spending limit.
PLATFORM_MONTHLY_BUDGET_USD=10
# Comma-separated emails for active staff allowed to use /platform.
# Supply this per deployment; do not commit actual administrator addresses.
PLATFORM_ADMIN_EMAILS=
# PlanetScale: create a service token with only read_branch on repairpilot-prod.
# Keep both credential fields secret. The token can also read branch metadata.
PLANETSCALE_ORGANIZATION=townmedialabs
PLANETSCALE_DATABASE=repairpilot-prod
PLANETSCALE_BRANCH=main
PLANETSCALE_SERVICE_TOKEN_ID=
PLANETSCALE_SERVICE_TOKEN=

# --- Email ------------------------------------------------------------------
# log (default — prints to the console) | resend
EMAIL_DRIVER=
RESEND_API_KEY=
EMAIL_FROM=

# --- SMS --------------------------------------------------------------------
# log (default) | twilio
SMS_DRIVER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Inbound email & SMS (app/api/inbound) ----------------------------------
# Customer replies become a public comment on their ticket. Both endpoints
# REFUSE every request until their secret is set — an inbound route that trusts
# anything lets a stranger write on a customer's ticket.
#
#   POST /api/inbound/email   Resend inbound (Svix-signed), or the generic JSON
#                             form guarded by ?token=INBOUND_SECRET
#   POST /api/inbound/sms     Twilio, verified with TWILIO_AUTH_TOKEN above
#
# Set the shop's inbound address in Settings → Messaging → Inbound so a message
# can be matched to the right tenant.
RESEND_WEBHOOK_SECRET=
INBOUND_SECRET=

# --- File storage (lib/storage) ---------------------------------------------
# "local" writes to public/uploads on this machine — right for a single box,
# wrong for anything with more than one instance or an ephemeral filesystem.
# "s3" speaks plain S3 with SigV4 and works against AWS, Cloudflare R2, MinIO
# and Backblaze B2. "r2" uses the private REPAIRPILOT_UPLOADS binding and is
# for a configured Cloudflare Worker. Existing rows record their driver, so
# switching strands nothing.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# --- Accounting integrations (lib/integrations/config.ts) -------------------
# QuickBooks Online. Register the redirect URI shown on the Integrations tab:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/quickbooks/callback
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_ENVIRONMENT="sandbox"   # sandbox | production

# Xero. Redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/xero/callback
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# Provider hosts. Leave these unset in production — the documented Intuit and
# Xero endpoints are used. They exist so scripts/dev/fake-quickbooks.mjs and
# scripts/dev/fake-xero.mjs can stand in for the real thing locally.
# QBO_AUTH_BASE="http://127.0.0.1:4310"
# QBO_OAUTH_BASE="http://127.0.0.1:4310"
# QBO_REVOKE_BASE="http://127.0.0.1:4310"
# QBO_API_BASE="http://127.0.0.1:4310"
# XERO_LOGIN_BASE="http://127.0.0.1:4311"
# XERO_IDENTITY_BASE="http://127.0.0.1:4311"
# XERO_API_BASE="http://127.0.0.1:4311"

# --- Background jobs --------------------------------------------------------
# Recurring invoices, campaign sends, SLA checks, outbound webhook delivery
# and housekeeping.
# In-app timer: how often it runs, and how long it waits after boot.
JOBS_INTERVAL_MIN=15
JOBS_FIRST_DELAY_S=60
# Shared secret for GET|POST /api/cron. Unset means that endpoint answers 503.
CRON_SECRET=

# --- AI assist --------------------------------------------------------------
# off (default) | anthropic | ollama
AI_DRIVER=
AI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_URL=
